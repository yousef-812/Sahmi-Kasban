# Application
APP_NAME=Sahmi Kasban API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
APP_PUBLIC_URL=http://localhost:8000
# Comma-separated accounts allowed to access protected administration APIs.
ADMIN_EMAILS=

# Observability and quality thresholds
LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
REQUEST_SLOW_THRESHOLD_MS=1500
QUALITY_ERROR_RATE_ALERT_PERCENT=5
QUALITY_P95_LATENCY_ALERT_MS=1000
QUALITY_MIN_REQUEST_COUNT=20
QUALITY_PROVIDER_STALE_MINUTES=60

# Database
# Use the Neon pooled URL for normal API traffic.
DATABASE_URL=postgresql+psycopg://sahmi:sahmi_dev_password@db:5432/sahmi_kasban
# Use the Neon direct URL for Alembic. Leave empty to fall back to DATABASE_URL.
MIGRATION_DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Authentication
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=30
JWT_ALGORITHM=HS256

# SMTP email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true

# AI providers
OPEN_WEBUI_URL=
OPEN_WEBUI_API_KEY=
GROQ_API_KEYS=
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=45
AI_MAX_TOKENS=1800
AI_TEMPERATURE=0.2

# Market data
MARKET_DATA_PRIMARY=tradingview
MARKET_DATA_FALLBACK=yfinance
MARKET_TIMEZONE=Africa/Cairo
MARKET_DATA_PERIOD=1y
MARKET_DATA_INTERVAL=1d
MARKET_DATA_CACHE_MINUTES=30
MARKET_DATA_TIMEOUT_SECONDS=20
MARKET_DATA_MIN_CANDLES=200

# TradingView history websocket and Egyptian stock catalog
TRADINGVIEW_WEBSOCKET_URL=wss://data.tradingview.com/socket.io/websocket
TRADINGVIEW_SCANNER_URL=https://scanner.tradingview.com/egypt/scan
TRADINGVIEW_ORIGIN=https://www.tradingview.com
TRADINGVIEW_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
TRADINGVIEW_AUTH_TOKEN=unauthorized_user_token
MARKET_INSTRUMENT_CATALOG_REFRESH_HOURS=12
MARKET_INSTRUMENT_CATALOG_RETRY_MINUTES=10
MARKET_INSTRUMENT_CATALOG_TIMEOUT_SECONDS=8
MARKET_INSTRUMENT_CATALOG_MAX_SYMBOLS=1000

# Stock analysis economics and risk defaults
ANALYSIS_COST_POINTS=50
ANALYSIS_DEFAULT_CAPITAL=150000
ANALYSIS_RISK_PER_TRADE=0.01
ANALYSIS_MAX_POSITION_VALUE=40000
ANALYSIS_ENGINE_VERSION=core-v2.3

# Daily EGX report scan
# Comma-separated ISO dates, maintained from the official exchange holiday calendar.
EGX_HOLIDAYS=
DAILY_SCAN_HOUR=15
DAILY_SCAN_MINUTE=0
DAILY_SCAN_MAX_CONCURRENCY=4
DAILY_SCAN_MIN_AVERAGE_TURNOVER_EGP=1000000
DAILY_SCAN_MIN_NONZERO_VOLUME_RATIO=0.80
DAILY_REPORT_SIZE=10
DAILY_REPORT_COST_POINTS=100
# The API machine polls the idempotent scan so restarts do not miss 15:00 Cairo.
DAILY_SCAN_SCHEDULER_ENABLED=true
DAILY_SCAN_SCHEDULER_POLL_SECONDS=60

# Weekly wallet grants. Cairo weeks start on Monday and grants are idempotent.
WEEKLY_GRANT_SCHEDULER_ENABLED=true
WEEKLY_GRANT_SCHEDULER_POLL_SECONDS=3600

# Historical replay worker
HISTORICAL_REPLAY_PROVIDER_CONCURRENCY=5
HISTORICAL_REPLAY_CPU_CONCURRENCY=2
HISTORICAL_REPLAY_CACHE_HOURS=24
HISTORICAL_REPLAY_PREPARED_CACHE_ENTRIES=320
HISTORICAL_REPLAY_ACTIVE_POLL_SECONDS=0.5
HISTORICAL_REPLAY_IDLE_POLL_SECONDS=5

# Push notifications: disabled, stub, or live.
FCM_DELIVERY_MODE=disabled
FCM_PROJECT_ID=
# Optional on Google Cloud: Application Default Credentials use the attached service account.
# Outside Google Cloud, provide JSON text or a mounted JSON file path and keep it secret.
FCM_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Google Play purchase verification: disabled, stub, or live.
GOOGLE_PLAY_PACKAGE_NAME=com.sahmikasban.sahmi_kasban_mobile
GOOGLE_PLAY_VERIFICATION_MODE=disabled
# JSON text or a mounted service-account JSON path. Never commit the real value.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Use an independent random value of at least 32 characters.
BILLING_TOKEN_ENCRYPTION_KEY=

# AdMob rewarded-ad server-side verification: disabled, stub, or live.
ADMOB_SSV_VERIFICATION_MODE=disabled
ADMOB_SSV_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json
ADMOB_ANDROID_REWARDED_AD_UNIT_ID=ca-app-pub-3940256099942544/5224354917
ADMOB_IOS_REWARDED_AD_UNIT_ID=ca-app-pub-3940256099942544/1712485313
ADMOB_REWARD_ITEM=coins
AD_REWARD_POINTS=75
AD_REWARD_DAILY_LIMIT=4
AD_REWARD_COOLDOWN_SECONDS=900
AD_REWARD_SESSION_MINUTES=15
ADMOB_SSV_MAX_CALLBACK_AGE_SECONDS=3600

# Production is intentionally fail-closed. APP_ENV=production requires HTTPS,
# PostgreSQL, SMTP, Sentry, ADMIN_EMAILS, live FCM, live Google Play verification,
# live AdMob SSV, non-test AdMob IDs, and valid service-account material.
